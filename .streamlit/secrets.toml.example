[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-random-secret-of-at-least-32-characters"
expose_tokens = ["id"]

[auth.cognito]
client_id = "replace-with-your-cognito-app-client-id"
client_secret = "provide-through-a-secret-manager"
server_metadata_url = "https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/openid-configuration"
