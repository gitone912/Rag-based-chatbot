# Required for hosted Qdrant and direct Groq generation
GEMINI_API_KEY=
EMBEDDING_PROVIDER=sentence-transformers
QDRANT_CLUSTER_ENDPOINT=http://localhost:6333
QDRANT_API_KEY=
# Primary application provider: groq (default) or portkey (opt-in)
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=512
RAG_MIN_RELEVANCE_SCORE=0.45
# Web search is used only when indexed documents do not answer an in-scope question.
# Uses the Groq GPT-OSS built-in browser search; no separate search key is needed.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_RESULTS=3
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# Optional Portkey provider credentials; used only with LLM_PROVIDER=portkey
PORTKEY_API_KEY=
PORTKEY_CONFIG_ID=
GROQ_API_KEY=
# Optional second Groq key used by the saved Portkey fallback route, not auto-routed by direct Groq.
GROQ_FALLBACK_API_KEY=

# Separate Groq key for RAGAS evaluation (avoids rate-limiting the live app)
JUDGE_GROQ=
# RAGAS judge model; Qwen has a separate available Groq model quota.
RAGAS_JUDGE_MODEL=qwen/qwen3.8-27b

# Optional shared service token. Set the same value for API and Streamlit.
API_AUTH_TOKEN=

# Optional observability
LOGFIRE_TOKEN=
# Use false for offline/local-only runs; defaults to exporting when a token exists.
LOGFIRE_SEND_TO_LOGFIRE=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Streamlit client and evaluation dashboard
BACKEND_URL=http://localhost:8000
