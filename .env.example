# Required for hosted Qdrant. Gemini key is also used for Gemini generation when selected.
GEMINI_API_KEY=
EMBEDDING_PROVIDER=sentence-transformers
QDRANT_CLUSTER_ENDPOINT=http://localhost:6333
QDRANT_API_KEY=
# Primary application provider: groq (default), gemini, or portkey (opt-in)
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=512
GROQ_MAX_RETRIES=0
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_RETRIES=0
RAG_MIN_RELEVANCE_SCORE=0.45
RAG_MAX_CONTEXT_CHARS=4000
RAG_MAX_HISTORY_CHARS=2000
RAG_HISTORY_MESSAGES=6
RAG_CANDIDATE_LIMIT=50
RAG_BM25_CONFIDENCE_MARGIN=0.10
# Optional Groq browser fallback. It can use substantial, variable input tokens.
# Keep disabled for predictable RAG token use; enable only with a usage budget.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_RESULTS=3
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# Optional Portkey provider credentials; used only with LLM_PROVIDER=portkey
PORTKEY_API_KEY=
PORTKEY_CONFIG_ID=
GROQ_API_KEY=
# Optional second Groq key used by the saved Portkey fallback route, not auto-routed by direct Groq.
GROQ_FALLBACK_API_KEY=

# Separate Groq key for RAGAS evaluation (avoids rate-limiting the live app)
JUDGE_GROQ=
# RAGAS judge model; Qwen has a separate available Groq model quota.
RAGAS_JUDGE_MODEL=qwen/qwen3.8-27b

# Optional shared service token. Set the same value for API and Streamlit.
API_AUTH_TOKEN=

# Multi-user production mode: Cognito ID tokens + Postgres checkpoints + Redis limits.
# APP_ENV=production fails startup unless production dependencies and TLS settings are complete.
# Keep APP_ENV=development and AUTH_MODE=none for private local development.
APP_ENV=development
AUTH_MODE=none
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_REQUIRED_GROUP=rag-users
CHECKPOINT_DATABASE_URL=
MEMORY_RETENTION_DAYS=30
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=1000
METRICS_BEARER_TOKEN=
EVAL_AUTH_TOKEN=

# Optional observability
LOGFIRE_TOKEN=
# Use false for offline/local-only runs; defaults to exporting when a token exists.
LOGFIRE_SEND_TO_LOGFIRE=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Streamlit client and evaluation dashboard
BACKEND_URL=http://localhost:8000
